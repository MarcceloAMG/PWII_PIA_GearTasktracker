{
  "info": {
    "name": "GearTask Tracker API",
    "description": "Colección de pruebas del backend. Usa el entorno 'GearTask local'. Corre las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Registro (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "Crea un usuario nuevo. Guarda token y correo en el entorno para las demás peticiones.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Ana Pérez\",\n  \"usuario\": \"ana_{{$timestamp}}\",\n  \"correo\": \"ana{{$timestamp}}@mail.com\",\n  \"password\": \"{{password}}\",\n  \"telefono\": \"{{$timestamp}}\",\n  \"rol\": \"Programador Backend\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('ok es true y trae token', () => {",
                  "  pm.expect(json.ok).to.eql(true);",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "});",
                  "pm.test('No devuelve la contraseña', () => pm.expect(json.data.usuario).to.not.have.property('password'));",
                  "pm.test('El plan inicial es basico', () => pm.expect(json.data.usuario.plan).to.eql('basico'));",
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.data.token);",
                  "pm.environment.set('correo', json.data.usuario.correo);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Registro con foto (form-data)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "En el campo foto elige una imagen (JPG, PNG, WEBP o GIF de hasta 2 MB). La foto queda en backend/uploads.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "foto",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "nombreCompleto",
                  "value": "Luis García",
                  "type": "text"
                },
                {
                  "key": "usuario",
                  "value": "luis_{{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "correo",
                  "value": "luis{{$timestamp}}@mail.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "telefono",
                  "value": "{{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "rol",
                  "value": "Programador Frontend",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('La foto queda en /uploads', () => pm.expect(json.data.usuario.foto).to.match(/^\\/uploads\\//));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Registro con correo repetido (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Otra Persona\",\n  \"usuario\": \"otro_{{$timestamp}}\",\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\",\n  \"telefono\": \"{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', () => pm.response.to.have.status(409));",
                  "pm.test('Dice que el correo ya existe', () => pm.expect(pm.response.json().mensaje).to.include('correo'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Registro con datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"A\",\n  \"usuario\": \"x\",\n  \"correo\": \"esto-no-es-un-correo\",\n  \"password\": \"123\",\n  \"telefono\": \"12345\",\n  \"rol\": \"Astronauta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('ok es false y trae mensaje', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.ok).to.eql(false);",
                  "  pm.expect(json.mensaje).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Login correcto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae token', () => pm.expect(pm.response.json().data.token).to.be.a('string'));",
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.data.token);",
                  "pm.environment.set('correo', json.data.usuario.correo);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Login con contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje genérico', () => pm.expect(pm.response.json().mensaje).to.eql('Correo o contraseña incorrectos'));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Ruta protegida con token (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me"
              ]
            },
            "description": "Usa el token guardado por el login (autorización Bearer heredada de la colección)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve al usuario sin contraseña', () => {",
                  "  const u = pm.response.json().data;",
                  "  pm.expect(u.correo).to.eql(pm.environment.get('correo'));",
                  "  pm.expect(u).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Ruta protegida sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Ruta protegida con token falso (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token.falso.123"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
