    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "10. Crear un segundo usuario (para las búsquedas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "No cambia el token guardado: solo guarda el usuario y teléfono del segundo usuario.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Carlos Ruiz\",\n  \"usuario\": \"carlos_{{sufijo}}\",\n  \"correo\": \"carlos{{sufijo}}@mail.com\",\n  \"password\": \"{{password}}\",\n  \"telefono\": \"{{telefonoNuevo}}\",\n  \"rol\": \"Diseñador\"\n}",
              "options": {
