                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje genérico', () => pm.expect(pm.response.json().mensaje).to.eql('Correo o contraseña incorrectos'));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Ruta protegida con token (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "me"
              ]
            },
            "description": "Usa el token guardado por el login (autorización Bearer heredada de la colección)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve al usuario sin contraseña', () => {",
                  "  const u = pm.response.json().data;",
                  "  pm.expect(u.correo).to.eql(pm.environment.get('correo'));",
                  "  pm.expect(u).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
