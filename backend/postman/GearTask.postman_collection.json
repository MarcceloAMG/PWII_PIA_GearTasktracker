            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json().data.usuario;",
                  "pm.environment.set('otroUsuario', u.usuario);",
                  "pm.environment.set('otroTelefono', u.telefono);"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Buscar usuario por nombre (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/buscar?usuario={{otroUsuario}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "buscar"
              ],
              "query": [
                {
                  "key": "usuario",
                  "value": "{{otroUsuario}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json().data;",
                  "pm.test('Encuentra al usuario', () => {",
                  "  pm.expect(lista).to.have.lengthOf(1);",
                  "  pm.expect(lista[0].usuario).to.eql(pm.environment.get('otroUsuario'));",
                  "});",
                  "pm.test('Solo datos públicos', () => {",
                  "  ['correo', 'telefono', 'password'].forEach((campo) => pm.expect(lista[0]).to.not.have.property(campo));",
                  "});"
                ]
              }
            }
          ]
        },
